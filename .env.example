# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase PostgreSQL (pooled connection — use port 6543 with ?pgbouncer=true)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection for Prisma migrations (port 5432)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Seed: host/admin email allowlist (must match Clerk sign-in email)
SEED_HOST_EMAIL=admin@example.com

# Protect /api/cron/* in production
CRON_SECRET=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# Cloudflare R2 — private guest documents
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=

# Cloudflare R2 — public property photos (optional separate bucket)
R2_BUCKET_PUBLIC=
R2_PUBLIC_BASE_URL=https://pub.example.r2.dev

# Supabase Realtime (optional — server broadcast only; client uses polling)
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend) — if unset, notifications are logged only
RESEND_API_KEY=
RESEND_FROM_EMAIL=OIKOS Spaces <hello@oikosspaces.com>

# WhatsApp Cloud API — if unset, messages are logged only
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mux video (optional — property video tours)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
NEXT_PUBLIC_MUX_ENV_KEY=
